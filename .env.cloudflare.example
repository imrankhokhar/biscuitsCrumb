# Copy to .env.cloudflare on the SERVER (never commit the real file).
# Used by: scripts/server-deploy-d1.sh

# Cloudflare API token — create at https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Account.D1 Edit, Account.Workers Scripts Edit, Account.Workers R2 Storage Edit, Account.Account Settings Read
CLOUDFLARE_API_TOKEN=

# Same account as wrangler.toml
CLOUDFLARE_ACCOUNT_ID=c572f097e1a07b2c249efa2921ec98b6

# App secret (also pushed to the Worker with `wrangler secret put`)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional
RECEIPT_ENCRYPTION_KEY=

# Public URL of THIS server (where nginx serves the UI), e.g. https://vending.example.com
# Used for Worker CORS after deploy instructions
PUBLIC_APP_URL=http://YOUR_SERVER_IP

# Where to put the built frontend on the server
WEB_ROOT=/var/www/biscuits-crumb

# Set to 1 to run D1 seed (fresh admin/roles). Skip after first deploy.
RUN_D1_SEED=1
