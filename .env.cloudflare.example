# Copy on the SERVER:  cp .env.cloudflare.example .env.cloudflare
# Then fill ONLY the two lines marked REQUIRED. Do not commit .env.cloudflare.

# --- REQUIRED (paste your values) ---
CLOUDFLARE_API_TOKEN=
JWT_SECRET=

# --- Already set for this project ---
CLOUDFLARE_ACCOUNT_ID=c572f097e1a07b2c249efa2921ec98b6

# Optional (falls back to JWT_SECRET)
RECEIPT_ENCRYPTION_KEY=

# Your server public URL (used for notes / CORS later). Change IP/domain.
PUBLIC_APP_URL=http://YOUR_SERVER_IP

# Frontend files on this server
WEB_ROOT=/var/www/biscuits-crumb

# 1 = seed fresh admin on deploy; set to 0 after first success
RUN_D1_SEED=1

# Admin password used only when RUN_D1_SEED=1
ADMIN_PASSWORD=admin123
