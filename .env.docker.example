# Copy to .env next to docker-compose.yml on the SERVER

HOST_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
RECEIPT_ENCRYPTION_KEY=
CLIENT_ORIGIN=http://YOUR_SERVER_IP:8080
COOKIE_SECURE=false

# ========== Pick ONE mode ==========

# --- A) SQLite on server (simple) ---
FORCE_SQLITE=1
DATABASE_URL=file:/data/db/app.db

# --- B) Cloudflare D1 (live) ---
# Comment out block A, use this instead:
# FORCE_SQLITE=0
# CLOUDFLARE_ACCOUNT_ID=c572f097e1a07b2c249efa2921ec98b6
# CLOUDFLARE_D1_DATABASE_ID=1f6ca043-2eef-415f-9f0c-16bec2161cd9
# CLOUDFLARE_API_TOKEN=your_token
# DATABASE_URL=file:./prisma/dev.db
# (DATABASE_URL is only a Prisma placeholder — real data is in D1)
# First time: run on a PC →  npm run d1:migrate:remote

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Excelorithm Vending <noreply@excelorithm.com>
