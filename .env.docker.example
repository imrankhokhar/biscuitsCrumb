# Copy to .env next to docker-compose.yml before `docker compose up -d`

HOST_PORT=8080

# Required — long random string
JWT_SECRET=change-me-to-a-long-random-string

# Optional — defaults to JWT_SECRET if empty
RECEIPT_ENCRYPTION_KEY=

# Browser origin that may call the API (cookies). Examples:
#   true
#   http://YOUR_SERVER_IP:8080
#   https://vending.example.com
CLIENT_ORIGIN=true

# Set true only behind HTTPS
COOKIE_SECURE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Excelorithm Vending <noreply@excelorithm.com>
