# =========================
# BiscuitsCrumb — server .env
# Copy to: server/.env
# =========================

PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

# SQLite file (TeamTask-style local/server DB — NOT Cloudflare D1 HTTP)
DATABASE_URL="file:./dev.db"

# Same-origin UI+API: leave true (reflects request origin)
CLIENT_ORIGIN=true
COOKIE_SECURE=false

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Excelorithm Vending <noreply@excelorithm.com>
