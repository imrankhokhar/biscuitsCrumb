# =========================
# BiscuitsCrumb — server .env
# Copy to: server/.env
# =========================

PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

CLIENT_ORIGIN=true
COOKIE_SECURE=false

# --- Database (TeamTask-style) ---
#
# LOCAL (default): SQLite file. start-web.cmd sets FORCE_SQLITE=1.
FORCE_SQLITE=1
DATABASE_URL="file:./dev.db"
#
# LIVE (server with D1): comment FORCE_SQLITE / set FORCE_SQLITE=0 and fill:
# CLOUDFLARE_ACCOUNT_ID=c572f097e1a07b2c249efa2921ec98b6
# CLOUDFLARE_D1_DATABASE_ID=1f6ca043-2eef-415f-9f0c-16bec2161cd9
# CLOUDFLARE_API_TOKEN=your_api_token
# (Prisma talks to D1 over HTTP — same idea as TeamTask)
# Apply schema once: npm run d1:migrate:remote  (from repo root)
# Then seed: FORCE_SQLITE=0 npm --prefix server run db:seed

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Excelorithm Vending <noreply@excelorithm.com>
